# Unity .gitignore - Universal (Windows & macOS)
#
# Base template: https://github.com/github/gitignore/blob/main/Unity.gitignore
# Global templates: https://github.com/github/gitignore/tree/main/Global

# ==============================
# Unity Generated Files
# ==============================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
.gradle/
obj.meta
.utmp/

# ==============================
# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
# ==============================
[Mm]emoryCaptures/

# ==============================
# Recordings can get excessive in size
# ==============================
/[Rr]ecordings/

# ==============================
# By default unity supports Blender asset imports,
# *.blend1 blender files do not need to be commited to version control.
# ==============================
*.blend1
*.blend1.meta

# ==============================
# Uncomment this line if you wish to ignore the asset store tools plugin
# ==============================
# /[Aa]ssets/AssetStoreTools*

# ==============================
# Visual Studio / Visual Studio Code / Rider / Consulo
# ==============================
.idea/
.vscode/
.vs/
.consulo/
ExportedObj/
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ==============================
# Unity3D generated meta files
# ==============================
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ==============================
# Unity3D generated file on crash reports
# ==============================
sysinfo.txt

# ==============================
# Mono auto generated files
# ==============================
mono_crash.*

# ==============================
# Crashlytics generated file
# ==============================
crashlytics-build.properties

# ==============================
# Builds
# ==============================
win64/
/android
/ios
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# ==============================
# TestRunner generated files
# ==============================
InitTestScene*.unity*

# ==============================
# Auto-generated scenes by play mode tests
# ==============================
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# ==============================
# Auto-generated cache in Assets folder
# ==============================
/[Aa]ssets/[Ss]ceneDependencyCache*

# ==============================
# Addressables default ignores, before user customizations
# ==============================
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*

# ==============================
# Packed Addressables
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
# ==============================
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# ==============================
# Visual Scripting auto-generated files
# ==============================
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# ==============================
# Temporary Unity Files
# ==============================
# Temporary auto-generated Android Assets
Assets/StreamingAssets/build_info.meta
Assets/StreamingAssets/build_info
Assets/StreamingAssets/appdata_bundled.json
Assets/StreamingAssets/appdata_bundled.json.meta

# Firebase config files (injected by CI/Vault, not tracked)
Assets/google-services.json
Assets/google-services.json.meta
Assets/GoogleService-Info.plist
Assets/GoogleService-Info.plist.meta

# ==============================
# Operating System Files
# ==============================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.temp
*.lnk
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# ==============================
# AI Development Tools
# ==============================
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/skills/
!.cursor/skills/**
.codex/*
!.codex/config.toml
!.codex/skills/
!.codex/skills/**
.continue
.agents
.plans
.claude/worktrees/

# ==============================
# Package Managers
# ==============================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-debug.log

# ==============================
# Miscellaneous
# ==============================

# Log files
*.log

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==============================
# Debug Settings
# ==============================
Packages/com.singularitygroup.hotreload/
Packages/packages-lock.json
DiExplorerSceneComponentsSaves.json

# ==============================
# XR local artifacts
# ==============================

Assets/XR/Settings/ARFoundationReplaySettings.asset
Assets/XR/Settings/ARFoundationReplaySettings.asset.meta

# ==============================
# Local generated content
# ==============================
Assets/Reports/
Assets/GeneratedLocalRepo/
Assets/GeneratedLocalRepo.meta

# Profiler analysis reports (local artifacts)
ProfilerCaptures/reports/

# Code coverage results (generated by scripts/coverage/run_coverage.sh)
/CodeCoverage/

.claude/
artifacts/

# Unity CLI test report
test-results.xml

# Art references: multi-megabyte style frames, kept locally
cozy-match3/docs/art/
